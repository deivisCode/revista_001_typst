  <citation>
    <layout font-variant="small-caps" font-weight="normal" delimiter=" ; " prefix="[" suffix="]">
      <text variable="citation-label" strip-periods="false" quotes="false" font-style="normal" font-variant="small-caps" font-weight="normal" vertical-align="baseline"/>
    </layout>
  </citation>
  <bibliography and="text" et-al-min="3" et-al-use-first="3" second-field-align="flush">
    <layout>
      <text variable="citation-label" font-variant="small-caps" prefix="[" suffix="]"/>
      <group suffix="; ">
        <text variable="title" strip-periods="false" quotes="false" font-style="italic" font-variant="normal" font-weight="normal" prefix=" " suffix=" "/>
        <choose>
          <if match="any" variable="edition">
            <text variable="edition" font-variant="normal" font-weight="bold" prefix=", edición "/>
          </if>
        </choose>
        <choose>
          <if match="any" variable="page">
            <text variable="page" form="short" font-weight="bold" prefix="  p. " suffix=" "/>
          </if>
        </choose>
      </group>
      <group suffix="; ">
        <names variable="author" prefix=" "/>
      </group>
      <group font-variant="normal" font-weight="normal" text-decoration="none" delimiter=", " prefix="(" suffix=")">
        <choose>
          <if match="any" variable="publisher issued publisher-place">
            <choose>
              <if match="any" variable="publisher">
                <text variable="publisher"/>
              </if>
            </choose>
            <choose>
              <if match="any" variable="publisher-place">
                <text variable="publisher-place"/>
              </if>
            </choose>
            <choose>
              <if match="any" variable="issued">
                <date date-parts="year-month" form="text" variable="issued" font-weight="normal" vertical-align="baseline"/>
              </if>
            </choose>
          </if>
        </choose>
      </group>
      <group>
        <choose>
          <if match="any" variable="DOI">
            <text variable="DOI" font-weight="normal" text-decoration="underline" prefix=" DOI: "/>
          </if>
        </choose>
      </group>
    </layout>
  </bibliography>
